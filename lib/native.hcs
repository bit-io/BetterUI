            ]
        ]
        if win.is_key_pressed(Key::Key7, KeyRepeat::Yes) [
            if shift [
                inp.chars.push("&")
            ] else [
                inp.chars.push("7")
            ]
        ]
        if win.is_key_pressed(Key::Key8, KeyRepeat::Yes) [
            if shift [
