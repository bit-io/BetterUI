            ]
        ]
        if win.is_key_pressed(Key::Comma, KeyRepeat::Yes) [
            if shift [
                inp.chars.push("<")
            ] else [
                inp.chars.push(",")
            ]
        ]
        if win.is_key_pressed(Key::Period, KeyRepeat::Yes) [
            if shift [
                inp.chars.push(">")
            ] else [
                inp.chars.push(".")
            ]
        ]
        if win.is_key_pressed(Key::Minus, KeyRepeat::Yes) [
            if shift [
                inp.chars.push("_")
            ] else [
                inp.chars.push("-")
            ]
        ]
        if win.is_key_pressed(Key::Equal, KeyRepeat::Yes) [
