        ]
        if win.is_key_pressed(Key::Backspace, KeyRepeat::Yes) [
            inp.keys.push("Backspace")
        ]
        if win.is_key_pressed(Key::Delete, KeyRepeat::Yes) [
            inp.keys.push("Delete")
        ]
        if win.is_key_pressed(Key::Enter, KeyRepeat::Yes) [
            inp.keys.push("Enter")
        ]
        if win.is_key_pressed(Key::Left, KeyRepeat::Yes) [
            inp.keys.push("Left")
        ]
        if win.is_key_pressed(Key::Right, KeyRepeat::Yes) [
            inp.keys.push("Right")
        ]
        if win.is_key_pressed(Key::Up, KeyRepeat::Yes) [
            inp.keys.push("Up")
        ]
        if win.is_key_pressed(Key::Down, KeyRepeat::Yes) [
